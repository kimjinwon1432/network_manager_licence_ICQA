], "correct": 0, "explanation": "description 뒤에 텍스트를 그대로 입력합니다."}, {"prompt": "시리얼 인터페이스를 Frame Relay 방식으로 캡슐화하는 명령은?", "options": ["encapsulation frame-relay", "frame-relay encapsulation", "encapsulation ppp frame-relay", "frame-relay mode"], "correct": 0, "explanation": "encapsulation frame-relay가 정확한 순서입니다."}, {"prompt": "이미 만들어진 access-list 1을 인터페이스에 적용하는 명령은?", "options": ["ip access-group 1 in", "access-list apply 1", "ip access-list 1 in", "apply access-list 1"], "correct": 0, "explanation": "ip access-group [번호] in/out으로 적용합니다."}, {"prompt": "DHCP 주소풀을 생성하는 명령은?", "options": ["ip dhcp pool [이름]", "dhcp create pool [이름]", "ip dhcp-server [이름]", "dhcp pool add [이름]"], "correct": 0, "explanation": "ip dhcp pool로 (dhcp-config) 모드에 진입합니다."}, {"prompt": "DHCP pool(dhcp-config 모드) 안에서 배포할 네트워크 대역을 지정하는 명령은?", "options": ["network [주소] [마스크]", "range [주소] [마스크]", "ip range [주소]", "pool-network [주소]"], "correct": 0, "explanation": "dhcp-config 모드에서 network [주소] [마스크]를 사용합니다."}, {"prompt": "정적 경로(static route)를 설정하는 명령 형식은?", "options": ["ip route [목적지네트워크] [마스크] [게이트웨이]", "route add [목적지] [인터페이스]", "ip static-route [게이트웨이] [목적지]", "route static [목적지] [마스크]"], "correct": 0, "explanation": "ip route [목적지] [마스크] [다음홉]이 정확한 형식입니다."}, {"prompt": "IP 라우팅이 꺼진 환경에서 기본 게이트웨이를 지정하는 명령은?", "options": ["ip default-gateway [IP]", "ip default-network [IP]", "ip route 0.0.0.0 0.0.0.0 [IP]", "ip gateway [IP]"], "correct": 0, "explanation": "ip default-gateway는 라우팅이 꺼진 환경에서 사용합니다."}, {"prompt": "라우터에 후보 기본 경로(디폴트 네트워크)를 지정하는 명령은?", "options": ["ip default-network [주소]", "ip default-gateway [주소]", "ip route default [주소]", "ip network default [주소]"], "correct": 0, "explanation": "ip default-network는 default-gateway와 다른 명령입니다."}, {"prompt": "VTY 라인에서 SSH로만 접속을 허용(텔넷 차단)하는 명령은?", "options": ["transport input ssh", "transport output ssh", "access ssh only", "line ssh input"], "correct": 0, "explanation": "transport input ssh는 들어오는 접속을 SSH로 제한합니다."}, {"prompt": "VTY에 password를 설정했을 때, 인증이 실제로 작동하려면 반드시 함께 입력해야 하는 명령은?", "options": ["login", "authenticate", "enable secret", "verify"], "correct": 0, "explanation": "password만 있고 login이 없으면 인증이 활성화되지 않습니다."}, {"prompt": "VTY 접속에서 5분 50초 동안 입력이 없으면 세션이 자동 종료되게 하는 명령은?", "options": ["exec-timeout 5 50", "session-timeout 5:50", "idle-timeout 05 50", "timeout 5 50"], "correct": 0, "explanation": "exec-timeout [분] [초] 형식입니다."}, {"prompt": "콘솔 접속에 비밀번호를 설정하려면 먼저 어떤 라인 모드로 들어가야 하는가?", "options": ["line console 0", "line vty 0 4", "line aux 0", "line console 0 4"], "correct": 0, "explanation": "콘솔은 물리적으로 1개뿐이라 범위 지정이 불가능합니다."}, {"prompt": "SNMP 커뮤니티 문자열을 'ICQA'로 지정하는 정식 Cisco IOS 명령은?", "options": ["snmp-server community ICQA", "snmp community ICQA", "community snmp ICQA", "ip snmp community ICQA"], "correct": 0, "explanation": "정식 명령은 snmp-server community [문자열]입니다."}, {"prompt": "라우터의 소프트웨어/IOS 버전 정보를 확인하는 명령은?", "options": ["show version", "show ios", "show info", "show system"], "correct": 0, "explanation": "show version은 가장 기본적인 확인 명령입니다."}, {"prompt": "라우팅 테이블 정보를 확인하는 명령은?", "options": ["show ip route", "show route table", "show routing", "show ip table"], "correct": 0, "explanation": "show ip route로 현재 라우팅 테이블을 확인합니다."}, {"prompt": "라우터의 호스트 이름(hostname)을 변경하는 명령은?", "options": ["hostname [이름]", "set hostname [이름]", "name router [이름]", "router-name [이름]"], "correct": 0, "explanation": "hostname 입력 즉시 프롬프트가 바뀝니다."}]}]};
const STORAGE_KEY = 'nqm2-quiz-progress-v1';

function loadProgress(){
  try{ return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; }catch(e){ return {}; }
}
function saveProgress(p){
  try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(p)); }catch(e){}
}
let progress = loadProgress();

let state = { screen:'home', catIndex:0, qIndex:0, answers:[], selected:null, showHint:false };

const app = document.getElementById('app');

function render(){
  if(state.screen === 'home') renderHome();
  else if(state.screen === 'quiz') renderQuiz();
  else if(state.screen === 'result') renderResult();
}

function renderHome(){
  let cards = DATA.categories.map((cat, i) => {
    let best = (progress[i] && progress[i].best) || null;
    let progHtml = best !== null ? `<div class="cat-progress">최고 ${best}/${cat.questions.length}</div>` : '';
    return `<div class="cat-card" onclick="startCategory(${i})">
      <div class="cat-info">
        <div class="num">SET ${String(i+1).padStart(2,'0')}</div>
        <div class="title">${cat.title}</div>
        <div class="meta">${cat.questions.length}문항</div>
      </div>
      <div style="text-align:right">${progHtml}<div class="cat-arrow">→</div></div>
    </div>`;
  }).join('');

  app.innerHTML = `
    <div class="home-hero">
      <div class="eyebrow">ICQA · NETWORK ADMIN LV.2</div>
      <h1>네트워크관리사 2급<br>실기 대비 퀴즈</h1>
      <p>기출 단답형 + 라우터 실기 명령어, 총 ${DATA.categories.reduce((a,c)=>a+c.questions.length,0)}문항. 세트를 골라 시작하세요.</p>
    </div>
    <div class="cat-list">${cards}</div>
    <div class="reset-row"><button class="reset-btn" onclick="resetAllProgress()">전체 기록 초기화</button></div>
    <footer>네트워크관리사 2급 실기 대비 · 모바일 웹퀴즈</footer>
  `;
}

function startCategory(i){
  state.screen = 'quiz';
  state.catIndex = i;
  state.qIndex = 0;
  state.answers = [];
  state.selected = null;
  state.showHint = false;
  render();
}

function renderQuiz(){
  const cat = DATA.categories[state.catIndex];
  const q = cat.questions[state.qIndex];
  const total = cat.questions.length;

  let hops = '';
  for(let i=0;i<total;i++){
    let cls = 'hop';
    if(i < state.qIndex) cls += ' done';
    else if(i === state.qIndex) cls += ' current';
    hops += `<div class="${cls}"></div>`;
  }

  let answered = state.selected !== null;
  let optionsHtml = q.options.map((opt, idx) => {
    let cls = 'option';
    if(answered){
      if(idx === q.correct) cls += ' correct';
      else if(idx === state.selected) cls += ' wrong';
    } else if(idx === state.selected){
      cls += ' selected';
    }
    let letter = String.fromCharCode(65+idx);
    return `<button class="${cls}" ${answered?'disabled':''} onclick="selectOption(${idx})">
      <span class="opt-letter">${letter}</span>${opt}
    </button>`;
  }).join('');

  let explainHtml = '';
  if(answered){
    let isCorrect = state.selected === q.correct;
    explainHtml = `<div class="explain-box ${isCorrect?'':'wrong-box'}">
      <div class="explain-label ${isCorrect?'ok':'no'}">${isCorrect?'정답입니다':'오답입니다 — 정답: '+q.options[q.correct]}</div>
      ${q.explanation}
    </div>
    <button class="next-btn" onclick="nextQuestion()">${state.qIndex < total-1 ? '다음 문제' : '결과 보기'}</button>`;
  }

  let hintHtml = '';
  if(q.hint && !answered){
    hintHtml = `<div class="hint-row">
      <button class="hint-btn" onclick="toggleHint()">${state.showHint?'힌트 숨기기':'힌트 보기'}</button>
      ${state.showHint ? `<div class="hint-text">${q.hint}</div>` : ''}
    </div>`;
  }

  app.innerHTML = `
    <div class="quiz-top">
      <button class="back-btn" onclick="goHome()">← 목록</button>
      <span class="qcount">${state.qIndex+1} / ${total}</span>
    </div>
    <div class="hop-trail">${hops}</div>
    <div class="qcard">
      <div class="qprompt">${q.prompt}</div>
      ${optionsHtml}
      ${hintHtml}
      ${explainHtml}
    </div>
  `;
}

function selectOption(idx){
  if(state.selected !== null) return;
  state.selected = idx;
  state.answers.push(idx === DATA.categories[state.catIndex].questions[state.qIndex].correct);
  render();
}

function toggleHint(){
  state.showHint = !state.showHint;
  render();
}

function nextQuestion(){
  const cat = DATA.categories[state.catIndex];
  if(state.qIndex < cat.questions.length - 1){
    state.qIndex++;
    state.selected = null;
    state.showHint = false;
    render();
  } else {
    finishQuiz();
  }
}

function finishQuiz(){
  const cat = DATA.categories[state.catIndex];
  const score = state.answers.filter(a=>a).length;
  const prev = progress[state.catIndex] || {best:0};
  progress[state.catIndex] = { best: Math.max(prev.best||0, score), last: score, total: cat.questions.length };
  saveProgress(progress);
  state.screen = 'result';
  render();
}

function renderResult(){
  const cat = DATA.categories[state.catIndex];
  const total = cat.questions.length;
  const score = state.answers.filter(a=>a).length;
  const pct = Math.round((score/total)*100);

  let wrongItems = [];
  cat.questions.forEach((q, i) => {
    if(state.answers[i] === false){
      wrongItems.push(`<div class="wrong-item">
        <div class="wq">${q.prompt}</div>
        <div class="wa">정답: ${q.options[q.correct]}</div>
      </div>`);
    }
  });
  let wrongHtml = wrongItems.length ? `<div class="wrong-list"><h3>틀린 문제 (${wrongItems.length})</h3>${wrongItems.join('')}</div>` : '';

  app.innerHTML = `
    <div class="result-wrap">
      <div class="result-score">${score}<span style="color:var(--muted);font-size:28px">/${total}</span></div>
      <div class="result-label">${cat.title} · 정답률 ${pct}%</div>
      <div class="result-bar"><div class="result-bar-fill" style="width:${pct}%"></div></div>
      <div class="result-actions">
        <button class="btn-primary" onclick="startCategory(${state.catIndex})">다시 풀기</button>
        <button class="btn-secondary" onclick="goHome()">세트 목록으로</button>
      </div>
      ${wrongHtml}
    </div>
  `;
}

function goHome(){
  state.screen = 'home';
  render();
}

function resetAllProgress(){
  if(confirm('모든 세트의 최고 기록을 초기화할까요?')){
    progress = {};
    saveProgress(progress);
    render();
  }
}

render();
</script>
